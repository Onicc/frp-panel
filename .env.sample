# Pin this to a tested v* tag in production.
FRP_PANEL_IMAGE=onicc/frp-panel:edge

# Generate one unique random value of at least 32 bytes and keep it permanently.
APP_GLOBAL_SECRET=""
APP_COOKIE_SECURE=true
# Enable only while creating the first Owner, then set to false.
APP_ENABLE_REGISTER=true
# Optional: override the repository that hosts install.sh/install.ps1 for the
# generated Client commands (useful for a maintained fork or an internal mirror).
# APP_AGENT_INSTALL_URL=https://raw.githubusercontent.com/Onicc/frp-panel/main

# Configure the public address once. HTTPS automatically derives WSS for RPC.
PUBLIC_URL=https://panel.example.com
